# ─────────────────────────────────────────────────────────────
# Trade Show Stands — environment variables
# Production: set these in Cloudflare Pages → Settings → Variables and Secrets
# (Production AND Preview environments). Local `wrangler pages dev`: copy to
# `.dev.vars` (same KEY=value format; git-ignored).
# ─────────────────────────────────────────────────────────────

# Required for email delivery (Resend — https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Lead inbox — sister's address is NOT known yet. Comma-separate multiple addresses.
LEAD_TO_EMAIL=LEADS-INBOX-TBC@brijnco.example

# Optional CC (e.g. Vladislav). Comma-separated.
LEAD_CC_EMAIL=

# Sender. The domain must be verified in Resend (DNS records on Cloudflare).
LEAD_FROM_EMAIL=Trade Show Stands <leads@tradeshowstands.com.au>

# Optional: also POST every lead as JSON to a webhook (Slack incoming webhook, Make, n8n, Zapier, CRM).
LEAD_WEBHOOK_URL=
# Optional: shared secret sent as the X-Lead-Secret header to the webhook.
LEAD_WEBHOOK_SECRET=

# Optional: extra allowed browser origins for the endpoint (comma-separated).
# tradeshowstands.com.au, www., *.pages.dev and localhost are always allowed.
ALLOWED_ORIGINS=

# Testing only: point Resend calls at a mock server.
# RESEND_API_URL=http://127.0.0.1:8799/emails

# ── Build-time (public) — analytics is OFF unless set ─────────
# PUBLIC_ANALYTICS_PROVIDER=plausible   # or ga4 / none
# PUBLIC_PLAUSIBLE_DOMAIN=tradeshowstands.com.au
# PUBLIC_GA4_ID=G-XXXXXXXXXX
