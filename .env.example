# Demo only. Change passwords before a public deployment. Never commit .env.
POSTGRES_PASSWORD=local-demo-change-me
ADMIN_TOKEN=replace-with-a-random-at-least-32-character-secret

DEMO_MODE=true
DEMO_REFERENCE_DATE=2026-11-14
APP_NAME=Ценоскоп
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ALLOWED_OUTBOUND_HOSTS=ozon.ru,www.ozon.ru,wildberries.ru,www.wildberries.ru
DATA_RETENTION_DAYS=90

# Browser collection is opt-in. Use a different secret from ADMIN_TOKEN.
COLLECTOR_ENABLED=false
COLLECTOR_TOKEN=
COLLECTOR_PERMISSION_REFERENCE=
COLLECTOR_LEASE_SECONDS=300

# Empty token keeps Telegram disabled; the site works without a bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate only for Telegram: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_ID_ENCRYPTION_KEY=

# Server uses Compose DNS; browser uses the locally exposed API.
API_BASE_URL=http://backend:8000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_NAME=Ценоскоп
