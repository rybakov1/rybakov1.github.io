{
  "name": "tradeshowstands",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8788",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name tradeshowstands"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
