---
interface Props {
  heading: string;
  text: string;
  href?: string;
  label?: string;
}
const { heading, text, href = '/stand-brief', label = 'Request a stand brief' } = Astro.props;
---

<aside class="landing-cta">
  <div>
    <p class="landing-cta__heading" set:html={heading} />
    <p class="landing-cta__text">{text}</p>
  </div>
  <div class="landing-cta__actions">
    <a class="btn" href={href}>{label}</a>
    <a class="text-link" href="/exhibition-stand-builders">How to brief a stand builder</a>
  </div>
</aside>

<style>
  .landing-cta {
    display: grid;
    gap: 1.25rem 2rem;
    align-items: center;
    margin: clamp(3rem, 7vw, 4.5rem) 0 0;
    padding: 1.75rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 820px) {
    .landing-cta {
      grid-template-columns: 1fr auto;
    }
  }

  .landing-cta__heading {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 360;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .landing-cta__heading :global(em) {
    font-style: italic;
    font-weight: 300;
    color: var(--ochre);
  }

  .landing-cta__text {
    margin: 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .landing-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
