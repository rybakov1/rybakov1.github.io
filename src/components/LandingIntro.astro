---
/**
 * Intro block for city / industry landing pages: prose + a side "sheet" of notes.
 */
interface Props {
  intro: string[];
  asideTitle: string;
  asideItems: string[];
  notesTitle: string;
  notes: string[];
}
const { intro, asideTitle, asideItems, notesTitle, notes } = Astro.props;
---

<section class="landing-intro">
  <div class="landing-intro__prose">
    {intro.map((p, i) => <p class:list={{ 'landing-intro__first': i === 0 }}>{p}</p>)}
  </div>
  <aside class="landing-intro__sheet">
    <p class="landing-intro__label">{asideTitle}</p>
    <ul class="landing-intro__venues">
      {asideItems.map((v) => <li>{v}</li>)}
    </ul>
    <p class="landing-intro__label">{notesTitle}</p>
    <ol class="landing-intro__notes">
      {
        notes.map((n, i) => (
          <li>
            <span>{String(i + 1).padStart(2, '0')}</span>
            <p>{n}</p>
          </li>
        ))
      }
    </ol>
  </aside>
</section>

<style>
  .landing-intro {
    display: grid;
    gap: 2rem;
    padding: 0 0 clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--ink);
    padding-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .landing-intro {
      grid-template-columns: 8.5rem minmax(0, 1fr) minmax(0, 22rem);
      column-gap: 1.75rem;
    }
    .landing-intro__prose {
      grid-column: 2;
    }
  }

  .landing-intro__prose p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 38rem;
  }

  .landing-intro__first::first-letter {
    font-family: var(--font-display);
    font-weight: 300;
    float: left;
    font-size: 3.4rem;
    line-height: 0.9;
    padding: 0.3rem 0.5rem 0 0;
    color: var(--ochre);
  }

  .landing-intro__sheet {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--ochre);
    padding: 1.25rem 1.25rem 0.5rem;
    align-self: start;
  }

  .landing-intro__label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .landing-intro__venues {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .landing-intro__venues li {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.35;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .landing-intro__notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .landing-intro__notes li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .landing-intro__notes li:last-child {
    border-bottom: none;
  }

  .landing-intro__notes span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ochre);
    padding-top: 0.2rem;
  }

  .landing-intro__notes p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
