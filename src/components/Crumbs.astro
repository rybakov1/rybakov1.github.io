---
interface Props {
  items: { name: string; path?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((it, i) => (
        <li>
          {it.path && i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    list-style: none;
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.25rem) 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    color: var(--ochre);
    margin: 0 0.5rem;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ochre-deep);
  }

  .crumbs [aria-current] {
    color: var(--ink-2);
  }
</style>
