---
/**
 * Calendar row — the date is the typographic hero of each line.
 * The show name is a stretched link covering the row; city and industry
 * chips are separate internal links layered above it (no nested anchors).
 * Extra attributes (data-* for filtering) are spread onto the <li>.
 */
import { getShowDateParts, formatShowDates, type TradeShow } from '../data/shows';
import { getIndustryBySlug, citySlug } from '../data/taxonomy';

interface Props {
  show: TradeShow;
  /** full = blurb + industry links (calendar page); compact = home list */
  variant?: 'full' | 'compact';
  /** hide the city link (e.g. on that city's own page) */
  hideCity?: boolean;
  [key: string]: unknown;
}

const { show, variant = 'compact', hideCity = false, ...attrs } = Astro.props;
const d = getShowDateParts(show);
const cats = show.categories.map((c) => getIndustryBySlug(c)).filter(Boolean);
const plate = cats[0];
---

<li class:list={['show-list__item', 'show-row', `show-row--${variant}`]} {...attrs}>
  <div class="show-row__link">
    {
      plate && (
        <img
          class="show-row__plate"
          src={`/images/industries/${plate.slug}.jpg`}
          alt=""
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <span class="show-row__date" aria-hidden="true">
      <span class="show-row__days">{d.days}</span>
      <span class="show-row__month">{d.month} {d.year}</span>
    </span>
    <span class="show-row__body">
      <a href={`/shows/${show.slug}/`} class="show-row__name">
        {show.name}
      </a>
      <span class="show-row__venue">
        <span class="sr-only">{formatShowDates(show)} · </span>{show.venue}
      </span>
      {variant === 'full' && <span class="show-row__blurb">{show.blurb}</span>}
      {
        (variant === 'full' || show.illustrative) && (
          <span class="tags">
            {show.illustrative && <span class="badge badge--muted">Verify</span>}
            {variant === 'full' &&
              cats.map((c) => (
                <a class="tag show-row__chip" href={`/shows/industry/${c!.slug}/`}>
                  {c!.short}
                </a>
              ))}
          </span>
        )
      }
    </span>
    {
      hideCity ? (
        <span class="show-row__city show-row__city--plain">{show.city}</span>
      ) : (
        <a class="show-row__city" href={`/shows/city/${citySlug(show.city)}/`} title={`More trade shows in ${show.city}`}>
          {show.city}
        </a>
      )
    }
    <span class="show-row__arrow" aria-hidden="true">→</span>
  </div>
</li>

<style>
  .show-row__link {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      'plate date city'
      'plate body body';
    gap: 0.6rem 1rem;
    padding: 1.4rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.25s var(--ease);
  }

  .show-row__plate {
    grid-area: plate;
    width: 4.5rem;
    height: 3.4rem;
    object-fit: cover;
    align-self: start;
    background: var(--paper-2);
  }

  .show-row__date {
    grid-area: date;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .show-row__days {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink);
  }

  .show-row__month,
  .show-row__city {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .show-row__city {
    grid-area: city;
    align-self: baseline;
    color: var(--ink-2);
  }

  .show-row__body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .show-row__name {
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 420;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    transition: color 0.2s var(--ease);
  }

  .show-row__venue {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .show-row__blurb {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 40rem;
  }

  .show-row .tags {
    align-items: center;
  }

  .show-row__arrow {
    display: none;
  }

  /* Stretched link: the whole row opens the show… */
  .show-row__name::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .show-row__name:focus-visible {
    outline: none;
  }

  .show-row__link:has(.show-row__name:focus-visible) {
    outline: 2px solid var(--ochre);
    outline-offset: 4px;
  }

  /* …while city + industry chips stay independently clickable */
  a.show-row__city,
  .show-row__chip {
    position: relative;
    z-index: 2;
    text-decoration: none;
  }

  a.show-row__city:hover,
  .show-row__chip:hover {
    color: var(--ochre-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .show-row__chip {
    color: var(--muted);
  }

  .show-row__link:hover .show-row__name {
    color: var(--ochre-deep);
  }

  @media (min-width: 720px) {
    .show-row__link {
      grid-template-columns: 6.5rem 8.5rem minmax(0, 1fr) 7.5rem 2rem;
      grid-template-areas: 'plate date body city arrow';
      align-items: start;
      gap: 0 1.75rem;
      padding: 1.6rem 0.75rem 1.6rem 0;
      isolation: isolate;
    }

    .show-row--full .show-row__link {
      padding-block: 2rem;
    }

    .show-row__plate {
      width: 6.5rem;
      height: 4.4rem;
    }

    .show-row__date {
      flex-direction: column;
      gap: 0.45rem;
    }

    .show-row__days {
      font-size: 2.35rem;
    }

    .show-row__name {
      font-size: 1.45rem;
    }

    .show-row__city {
      padding-top: 0.55rem;
    }

    .show-row__arrow {
      display: block;
      grid-area: arrow;
      justify-self: end;
      padding-top: 0.2rem;
      font-size: 1.25rem;
      color: var(--rule);
      transition:
        color 0.2s var(--ease),
        transform 0.3s var(--ease);
    }

    .show-row__link::before {
      content: '';
      position: absolute;
      inset: 0 -1rem;
      background: var(--sheet);
      opacity: 0;
      z-index: -1;
      transition: opacity 0.25s var(--ease);
    }

    .show-row__link:hover::before {
      opacity: 1;
    }

    .show-row__link:hover .show-row__arrow {
      color: var(--ochre);
      transform: translateX(4px);
    }
  }
</style>
