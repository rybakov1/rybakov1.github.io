---
import { t } from '../i18n/en';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
  /** Optional section number shown in the heading rule, e.g. "03" */
  number?: string;
  intro?: string;
}

const strings = t();
const { items, title = strings.faq, number, intro } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby="faq-heading">
      <div class="faq__head">
        {number && <span class="section-head__num">{number}</span>}
        <h2 id="faq-heading">{title}</h2>
        {intro && <p class="faq__intro">{intro}</p>}
      </div>
      <ol class="faq__list">
        {items.map((item, i) => (
          <li>
            <details class="faq__item" open={i === 0}>
              <summary>
                <span class="faq__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq__q">{item.question}</span>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <div class="faq__answer" set:html={item.answer} />
            </details>
          </li>
        ))}
      </ol>
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </section>
  )
}

<style>
  .faq {
    display: grid;
    gap: 1.5rem 3rem;
    border-top: 1px solid var(--ink);
    padding-top: 1rem;
  }

  .faq__head h2 {
    margin: 0.35rem 0 0.75rem;
  }

  .faq__intro {
    color: var(--muted);
    max-width: 18rem;
    font-size: 0.95rem;
  }

  .faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .faq__list li {
    border-bottom: 1px solid var(--rule);
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: 2.25rem 1fr 1.25rem;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ochre);
  }

  .faq__q {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 420;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.2s var(--ease);
  }

  .faq__item summary:hover .faq__q {
    color: var(--ochre-deep);
  }

  .faq__icon {
    position: relative;
    width: 0.85rem;
    height: 0.85rem;
    align-self: center;
    justify-self: end;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    padding: 0 2rem 1.5rem 3rem;
    color: var(--ink-2);
    font-size: 0.975rem;
    max-width: 40rem;
  }

  .faq__answer :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 720px) {
    .faq__head {
      display: grid;
      grid-template-columns: 4.5rem 1fr;
      align-content: start;
    }
    .faq__head .section-head__num {
      padding-top: 0.75rem;
    }
    .faq__head h2,
    .faq__intro {
      grid-column: 2;
    }
  }

  @media (min-width: 960px) {
    .faq {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }
    .faq__list {
      border-top: none;
    }
    .faq__list li:first-child summary {
      padding-top: 0.6rem;
    }
  }
</style>
