---
import BaseLayout from '../layouts/BaseLayout.astro';
import StandBriefForm from '../components/StandBriefForm.astro';

const preselected = Astro.url.searchParams.get('show') ?? '';
---

<BaseLayout
  title="Request a stand brief"
  description="Send a structured exhibition stand brief for Australian trade shows. Free enquiry handled by Brijnco — shell scheme, space only, or custom build."
  path="/stand-brief"
>
  <div class="wrap brief-layout">
    <aside class="brief-aside">
      <header>
        <p class="eyebrow eyebrow--rule">Stand brief · Free · ~3 min</p>
        <h1>Brief<br /><em>the stand.</em></h1>
        <p class="lead">
          Share size, budget and timing. We pass your enquiry to Brijnco — an Australian
          exhibition stand builder. No charge to submit.
        </p>
      </header>

      <div class="brief-next">
        <h2 class="brief-next__title">What happens next</h2>
        <ol>
          <li>
            <span>01</span>
            <p><strong>Your brief is reviewed</strong> by the Brijnco stand team.</p>
          </li>
          <li>
            <span>02</span>
            <p><strong>They get in touch</strong> to clarify the floorplan, look and logistics.</p>
          </li>
          <li>
            <span>03</span>
            <p><strong>You receive a proposal</strong> directly — nothing is sold on this site.</p>
          </li>
        </ol>
      </div>

      <p class="small brief-aside__foot">
        Not sure what to ask for? Read the <a href="/exhibition-stand-builders">stand builder guide</a>
        first. How we handle your details: <a href="/privacy">Privacy policy</a>.
      </p>
    </aside>

    <div class="brief-main">
      <StandBriefForm preselectedSlug={preselected} />
    </div>
  </div>
</BaseLayout>

<style>
  .brief-layout {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5.5rem);
  }

  .brief-aside h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    margin-bottom: 1.25rem;
  }

  .brief-next {
    margin-top: 2.25rem;
    border-top: 1px solid var(--ink);
    padding-top: 1rem;
  }

  .brief-next__title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .brief-next ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .brief-next li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .brief-next li span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ochre);
    padding-top: 0.2rem;
  }

  .brief-next li p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .brief-next li strong {
    font-weight: 560;
  }

  .brief-aside__foot {
    margin-top: 1.5rem;
  }

  /* Small screens: heading, then the form, then "what happens next" */
  @media (max-width: 899px) {
    .brief-aside {
      display: contents;
    }
    .brief-main {
      order: 2;
    }
    .brief-next,
    .brief-aside__foot {
      order: 3;
      margin: 0;
    }
    .brief-layout {
      row-gap: 2rem;
    }
  }

  @media (min-width: 900px) {
    .brief-layout {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: 5rem;
      align-items: start;
    }
    .brief-aside {
      position: sticky;
      top: 6rem;
    }
  }
</style>
