# Separate settings for docker-compose.public.yml; copy to .env.public locally.
# Real DNS name resolving to the VPS (no scheme or path).
SITE_DOMAIN=
# Keep false until the public content has been reviewed.
PUBLIC_INDEXABLE=false
# Generate each secret independently: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=
ADMIN_TOKEN=
